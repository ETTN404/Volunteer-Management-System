APP_NAME=VolunTrack
APP_ENV=production
APP_KEY=base64:DMSl1iTd3fyKE73HyRa68PJB2EAwThrK8TEJ1EsMj9o=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Standard error logging so output streams live into Wasmer / Docker live tail
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Database Connection (Default SQLite; change to mysql for cloud database)
DB_CONNECTION=sqlite
# DB_DATABASE=/tmp/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=voluntrack
# DB_USERNAME=root
# DB_PASSWORD=

# Use cookie or file for sessions so landing page works without database dependency
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Array or file cache
CACHE_STORE=array

MAIL_MAILER=log
MAIL_FROM_ADDRESS="notifications@voluntrackapp.com"
MAIL_FROM_NAME="VolunTrack Platform"

# Google Gemini API Key for VolunBot AI Chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------
# Review fixes (2026-10-20)
# ---------------------------------------------------------------
# Public address of the React app — used in invitation / reset / notification emails.
FRONTEND_URL=https://your-app.vercel.app
# Invitation links stay valid this many hours (they also burn on first use).
VMS_INVITATION_HOURS=72
# Also email in-app notifications (needs a working MAIL_MAILER, e.g. smtp).
VMS_NOTIFY_MAIL=false

# Payments — where organizations send money (shown on Plan & billing).
PAY_ACCOUNT_NAME="VolunTrack PLC"
PAY_TELEBIRR_ACCOUNT=0911000000
PAY_CBE_ACCOUNT=1000000000000
# Last digits of OUR receiving account: receipts paid to any other account are refused.
PAY_RECEIVER_ACCOUNT_SUFFIX=

# Automatic receipt verification (see docs/PAYMENT_VERIFICATION.md).
PAYMENT_VERIFY_DRIVERS=verifyet,cheki
VERIFYET_API_KEY=
# Optional: self-hosted cheki instance (recommended, runs from an Ethiopian IP).
CHEKI_URL=https://cheki.et/api/verify

# Alerts outside the app (optional)
# Telegram (free): create a bot with @BotFather, then register the webhook once:
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=<API_URL>/api/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# SMS: "log" (default, writes to the log) or "afromessage" (https://afromessage.com)
SMS_DRIVER=log
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER=
SMS_SENDER=VolunTrack
