APP_NAME=VolunTrack
APP_ENV=production
APP_KEY=base64:DMSl1iTd3fyKE73HyRa68PJB2EAwThrK8TEJ1EsMj9o=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Standard error logging so output streams live into Wasmer / Docker live tail
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Database Connection (Default SQLite; change to mysql for cloud database)
DB_CONNECTION=sqlite
# DB_DATABASE=/tmp/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=voluntrack
# DB_USERNAME=root
# DB_PASSWORD=

# Use cookie or file for sessions so landing page works without database dependency
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Array or file cache
CACHE_STORE=array

MAIL_MAILER=log
MAIL_FROM_ADDRESS="notifications@voluntrackapp.com"
MAIL_FROM_NAME="VolunTrack Platform"

# Google Gemini API Key for VolunBot AI Chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
