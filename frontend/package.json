{
  "name": "voluntrack-frontend",
  "private": true,
  "version": "2.0.0",
  "description": "VolunTrack — multi-tenant volunteer operations platform (React frontend)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:live": "vite --mode live",
    "geo": "node scripts/build-geo.mjs",
    "predev": "node scripts/build-geo.mjs",
    "prebuild": "node scripts/build-geo.mjs",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.3",
    "@yudiel/react-qr-scanner": "2.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "country-state-city": "3.2.1",
    "date-fns": "4.4.0",
    "leaflet": "1.9.4",
    "lenis": "1.3.27",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "0.577.0",
    "motion": "12.43.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.4.3",
    "react": "19.1.10",
    "react-day-picker": "9.14.0",
    "react-dom": "19.1.10",
    "react-dropzone": "14.3.8",
    "react-hook-form": "7.90.0",
    "react-leaflet": "5.0.0",
    "react-router": "7.18.4",
    "recharts": "2.15.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/noto-sans-ethiopic": "5.3.0",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/react-query-devtools": "5.104.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.19.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
