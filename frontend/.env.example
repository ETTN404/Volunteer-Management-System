# Base URL of the Laravel API (must end with /api)
VITE_API_URL=http://localhost:8000/api

# Mock Service Worker mode:
#   off     -> every request hits the real Laravel API
#   pending -> only endpoints the backend has NOT built yet are mocked (see docs/PENDING_BACKEND_CONTRACTS.md)
#   all     -> full in-memory backend (offline demo, E2E tests)
VITE_MOCK_MODE=off

# Show one-click demo account chips on the sign-in page
VITE_SHOW_DEMO_ACCOUNTS=true

# Public URL of this frontend (used for share / verify links)
VITE_APP_URL=http://localhost:5173
